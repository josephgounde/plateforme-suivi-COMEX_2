# .NET build output (each pdoe-backend/*/ project)
pdoe-backend/**/bin/
pdoe-backend/**/obj/

# Visual Studio local state
pdoe-backend/.vs/
*.user
*.suo

# Local secrets — see appsettings.Development.json.example for the template
pdoe-backend/PDOE.Api/appsettings.Development.json

# Runtime-uploaded files, not source
pdoe-backend/.local-storage/

# Office lock files
~$*.docx
~$*.xlsx
~$*.pptx

# OS junk
Thumbs.db
.DS_Store

# Local Claude Code tool settings, not shared project config
.claude/settings.json

# Personal weekly reports, not project deliverables
Documents/rapport_bi_hebdomadaire_*.docx

# infra/ : only the active HA POC and its backups are pushed — earlier/alternate
# experiments (ha-pdoe-real, ha-poc-mssql) and generated reports stay local
infra/ha-pdoe-real/
infra/ha-poc-mssql/
infra/report/

# infra/ha-poc-pdoe, infra/sql-backups : keep the compose file and .sql scripts,
# but never commit secrets or the SQL Server backup/log binaries
infra/**/.env
infra/**/*.pvk
infra/**/corosync.authkey
infra/**/*.bak
infra/**/*.trn
